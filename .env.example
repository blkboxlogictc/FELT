# Supabase — find these in your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose this client-side.
# Kept only as a future internal-ops escape hatch; not used by any
# user-facing action in this app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Your deployed URL (used for Supabase auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
